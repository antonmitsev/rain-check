{
  "name": "rain-check",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-icons.mjs && vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/prepare-icons.mjs && npm run typecheck && vite build && node scripts/prepare-pwa.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test tests/*.test.js"
  },
  "dependencies": {
    "vite": "^6.3.5"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.10.2",
    "sass": "^1.83.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
